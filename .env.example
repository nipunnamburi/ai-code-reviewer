# OpenAI API Key (Optional - server will use local fallback heuristics if not provided)
OPENAI_API_KEY=your_openai_api_key_here
PORT=8000

# LangSmith Tracing (Optional - set to true to log traces to LangSmith)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=ai-code-reviewer
